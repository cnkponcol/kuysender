APP_NAME="KuySender"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://wa.example.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kuysender
DB_USERNAME=kuysender
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_ENCRYPT=true
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local

WA_SERVICE_URL=http://127.0.0.1:5570
WA_INTERNAL_TOKEN=
WA_REQUEST_TIMEOUT=20
WA_QR_TTL_SECONDS=90

API_DEFAULT_RATE_LIMIT=60
API_ALLOWED_ORIGINS=

WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_ATTEMPTS=5

AI_DEFAULT_PROVIDER_URL=
AI_DEFAULT_API_KEY=
AI_DEFAULT_MODEL=
AI_MAX_CONTEXT_MESSAGES=12

BROADCAST_WORKER_BATCH=50
BROADCAST_MIN_DELAY_SECONDS=15
BROADCAST_MAX_DELAY_SECONDS=45
BROADCAST_STOP_ERROR_RATE=35
